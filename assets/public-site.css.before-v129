:root{
  --bg:#16001f;
  --panel:rgba(255,255,255,.095);
  --panel2:rgba(255,255,255,.065);
  --line:rgba(255,255,255,.18);
  --text:#fff;
  --muted:#f1d7ff;
  --pink:#ff2fa8;
  --purple:#7c3cff;
  --gold:#ffd15c;
  --green:#00d084;
  --blue:#3b82f6;
}

*{box-sizing:border-box}

html{
  -webkit-text-size-adjust:100%;
}

body{
  margin:0;
  min-height:100vh;
  color:var(--text);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  background:
    radial-gradient(circle at 20% 5%,rgba(255,47,168,.38),transparent 28%),
    radial-gradient(circle at 82% 12%,rgba(255,209,92,.26),transparent 25%),
    radial-gradient(circle at 50% 40%,rgba(124,60,255,.45),transparent 36%),
    linear-gradient(180deg,#4b0058 0%,#23002f 45%,#090012 100%);
  -webkit-font-smoothing:antialiased;
}

a{color:inherit}

.site-header{
  position:sticky;
  top:0;
  z-index:10;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:16px clamp(18px,4vw,44px);
  background:rgba(15,0,25,.72);
  backdrop-filter:blur(16px);
  border-bottom:1px solid var(--line);
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  text-decoration:none;
  font-size:20px;
  font-weight:950;
  letter-spacing:-.04em;
}

.brand-mark{
  width:42px;
  height:42px;
  display:grid;
  place-items:center;
  border-radius:14px;
  background:linear-gradient(145deg,var(--pink),var(--purple));
  box-shadow:0 0 28px rgba(255,47,168,.55);
  font-size:24px;
}

.site-nav{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.site-nav a{
  min-height:42px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:9px 14px;
  border:1px solid var(--line);
  border-radius:999px;
  background:rgba(255,255,255,.08);
  text-decoration:none;
  font-weight:850;
}

.hero{
  position:relative;
  overflow:hidden;
  min-height:560px;
  display:grid;
  place-items:center;
  padding:80px 20px 60px;
  text-align:center;
}

.hero:before{
  content:"";
  position:absolute;
  inset:0;
  background:
    repeating-conic-gradient(from 0deg,rgba(255,255,255,.08) 0deg 4deg,transparent 4deg 12deg);
  opacity:.22;
  transform:scale(1.4);
}

.hero-glow{
  position:absolute;
  width:min(680px,80vw);
  height:min(680px,80vw);
  border-radius:999px;
  background:radial-gradient(circle,rgba(255,209,92,.22),rgba(255,47,168,.12),transparent 70%);
  filter:blur(2px);
}

.hero-content{
  position:relative;
  max-width:940px;
}

.eyebrow{
  margin:0 0 12px;
  color:var(--gold);
  font-size:14px;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.2em;
}

h1{
  margin:0;
  font-size:clamp(44px,8vw,104px);
  line-height:.92;
  font-weight:1000;
  letter-spacing:-.075em;
  text-transform:uppercase;
  text-shadow:0 0 28px rgba(255,255,255,.45),0 0 50px rgba(255,47,168,.5);
}

.subtitle{
  max-width:740px;
  margin:22px auto 0;
  color:#fff;
  font-size:clamp(18px,2.4vw,26px);
  line-height:1.32;
  font-weight:700;
}

.hero-actions{
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:14px;
  margin-top:30px;
}

.btn{
  min-height:56px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:14px 22px;
  border-radius:16px;
  border:1px solid var(--line);
  color:#fff;
  text-decoration:none;
  font-weight:950;
  letter-spacing:-.015em;
  box-shadow:0 14px 34px rgba(0,0,0,.28);
}

.btn-primary,
.btn-facebook{
  background:linear-gradient(135deg,var(--pink),var(--purple));
}

.btn-secondary{
  background:rgba(255,255,255,.11);
}

.btn-green{
  background:linear-gradient(135deg,#00d084,#00a36d);
}

.btn-gold{
  background:linear-gradient(135deg,#ffd15c,#ff9f1c);
  color:#18051f;
}

.hero-note{
  color:var(--muted);
  margin-top:18px;
  font-weight:650;
}

.cards{
  width:min(1180px,100%);
  margin:-60px auto 0;
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
  padding:0 20px;
}

.card{
  min-height:230px;
  padding:24px;
  border:1px solid var(--line);
  border-radius:26px;
  background:linear-gradient(180deg,var(--panel),var(--panel2));
  box-shadow:0 18px 50px rgba(0,0,0,.28);
  backdrop-filter:blur(14px);
}

.card-icon{
  font-size:36px;
  margin-bottom:12px;
}

.card h2,
.event-strip h2,
.wifi-strip h2{
  margin:0;
  font-size:26px;
  font-weight:950;
  letter-spacing:-.04em;
}

.card p,
.event-strip p,
.wifi-strip p{
  color:var(--muted);
  font-size:16px;
  line-height:1.45;
}

.card a{
  display:inline-flex;
  margin-top:8px;
  color:var(--gold);
  font-weight:950;
  text-decoration:none;
}

.event-strip,
.wifi-strip{
  width:min(1180px,calc(100% - 40px));
  margin:22px auto 0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:26px;
  border:1px solid var(--line);
  border-radius:26px;
  background:rgba(0,0,0,.24);
  box-shadow:0 18px 50px rgba(0,0,0,.24);
}

.wifi-strip{
  margin-bottom:40px;
  justify-content:flex-start;
}

.wifi-icon{
  width:64px;
  height:64px;
  flex:0 0 64px;
  display:grid;
  place-items:center;
  border-radius:20px;
  background:rgba(255,255,255,.10);
  font-size:32px;
}

.coming-soon{
  display:inline-flex;
  min-height:48px;
  align-items:center;
  justify-content:center;
  padding:12px 16px;
  border-radius:14px;
  background:rgba(255,255,255,.10);
  color:var(--gold);
  font-weight:950;
  white-space:nowrap;
}

.site-footer{
  display:flex;
  justify-content:space-between;
  gap:18px;
  flex-wrap:wrap;
  padding:26px clamp(18px,4vw,44px);
  color:var(--muted);
  border-top:1px solid var(--line);
  background:rgba(0,0,0,.30);
}

.site-footer p{
  margin:0;
}

.site-footer a{
  text-decoration:none;
  color:#fff;
  font-weight:750;
}

@media(max-width:860px){
  .site-header{
    align-items:flex-start;
    flex-direction:column;
  }

  .cards{
    grid-template-columns:1fr;
    margin-top:-30px;
  }

  .event-strip,
  .wifi-strip{
    align-items:flex-start;
    flex-direction:column;
  }
}

@media(max-width:520px){
  .hero{
    min-height:500px;
    padding-top:60px;
  }

  .btn{
    width:100%;
  }

  .site-nav{
    width:100%;
  }

  .site-nav a{
    flex:1;
  }
}
